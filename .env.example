# ---- LLM / OpenRouter ----
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=qwen/qwen3.6-plus:free

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Repository defaults ----
DEFAULT_REPO_URL=https://github.com/fastapi/fastapi.git
DEFAULT_REPO_REF=

# ---- Service ports ----
ORCHESTRATOR_PORT=8010
INDEXER_PORT=8011
GRAPH_QUERY_PORT=8012
CODE_ANALYST_PORT=8013
MEMORY_PORT=8014
GATEWAY_PORT=8000

# ---- General ----
LOG_LEVEL=INFO
ENVIRONMENT=development
