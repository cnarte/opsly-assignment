# Development environment — local services, verbose logging
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# LLM
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Neo4j (local Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Redis (local Docker)
REDIS_URL=redis://localhost:6379/0

# Repository defaults
DEFAULT_REPO_URL=https://github.com/fastapi/fastapi.git
DEFAULT_REPO_REF=

# Service ports
ORCHESTRATOR_PORT=8010
INDEXER_PORT=8011
GRAPH_QUERY_PORT=8012
CODE_ANALYST_PORT=8013
MEMORY_PORT=8014
GATEWAY_PORT=8000

# MCP client behaviour
MCP_CALL_TIMEOUT_S=120
MCP_CALL_RETRIES=1
