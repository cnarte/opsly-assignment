# Testing environment — in-memory/mock services where possible
ENVIRONMENT=testing
LOG_LEVEL=WARNING

# LLM — override with a mock or stub in tests
OPENROUTER_API_KEY=test-key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Neo4j (test instance or mocked in unit tests)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword
NEO4J_DATABASE=neo4j

# Redis (test instance or mocked in unit tests)
REDIS_URL=redis://localhost:6379/1

# Repository defaults
DEFAULT_REPO_URL=https://github.com/fastapi/fastapi.git
DEFAULT_REPO_REF=

# Service ports (same as dev, tests mock MCP calls)
ORCHESTRATOR_PORT=8010
INDEXER_PORT=8011
GRAPH_QUERY_PORT=8012
CODE_ANALYST_PORT=8013
MEMORY_PORT=8014
GATEWAY_PORT=8000

# Shorter timeouts to catch hangs in tests
MCP_CALL_TIMEOUT_S=10
MCP_CALL_RETRIES=0
