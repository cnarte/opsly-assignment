# Production environment — set all secrets via deployment environment variables
# DO NOT commit real secrets to this file.
ENVIRONMENT=production
LOG_LEVEL=INFO

# LLM — set via deployment secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Neo4j — set via deployment secret or managed service
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Redis — set via deployment secret or managed service
REDIS_URL=redis://redis:6379/0

# Repository defaults
DEFAULT_REPO_URL=https://github.com/fastapi/fastapi.git
DEFAULT_REPO_REF=

# Service ports (Docker Compose uses these)
ORCHESTRATOR_PORT=8010
INDEXER_PORT=8011
GRAPH_QUERY_PORT=8012
CODE_ANALYST_PORT=8013
MEMORY_PORT=8014
GATEWAY_PORT=8000

# MCP client behaviour
MCP_CALL_TIMEOUT_S=60
MCP_CALL_RETRIES=2
